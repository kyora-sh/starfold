{
	"name": "starfold",
	"private": true,
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"fmt": "oxfmt .",
		"fmt:check": "oxfmt --check .",
		"lint": "oxlint",
		"typecheck": "bun run --filter '*' typecheck",
		"test": "bun run --filter '*' test",
		"check": "bun run fmt:check && bun run lint && bun run typecheck"
	},
	"devDependencies": {
		"oxfmt": "0.59.0",
		"oxlint": "1.80.0"
	}
}
