{
	"name": "starfold-docs",
	"version": "0.0.0",
	"private": true,
	"description": "The documentation site at starfold.kyora.sh",
	"scripts": {
		"postinstall": "fumadocs-mdx",
		"dev": "next dev",
		"build": "next build",
		"check-types": "fumadocs-mdx && next typegen && tsc --noEmit",
		"check-flags": "bun scripts/check-flags.ts",
		"preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
		"deploy": "opennextjs-cloudflare build && wrangler deploy"
	},
	"dependencies": {
		"@opennextjs/cloudflare": "1.20.14",
		"fumadocs-core": "16.6.14",
		"fumadocs-mdx": "14.2.9",
		"fumadocs-ui": "16.6.14",
		"lucide-react": "^0.577.0",
		"next": "16.4.3",
		"react": "^19.2.4",
		"react-dom": "^19.2.4"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4.2.1",
		"@types/bun": "1.4.2",
		"@types/mdx": "^2.0.13",
		"@types/node": "^25.3.5",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"postcss": "^8.5.8",
		"tailwindcss": "^4.2.1",
		"typescript": "^5.9.3",
		"wrangler": "4.152.0"
	}
}
