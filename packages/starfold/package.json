{
	"name": "starfold",
	"version": "0.4.0",
	"description": "TypeScript client for starfold: screenshots, waiting for the screen, mouse and keyboard",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kyora-sh/starfold.git",
		"directory": "packages/starfold"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"typecheck": "tsc -p .",
		"test": "bun run build && bun test test/",
		"test:integration": "node test/integration.mjs"
	},
	"devDependencies": {
		"@types/node": "20.19.9",
		"typescript": "5.8.2"
	},
	"engines": {
		"node": ">=20"
	}
}
